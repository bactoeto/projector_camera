{
  "patterns": "./patterns",
  "output_dir": "./output",
  "pattern_colorspace": "sRGB",

  "render": {
    "samples": 64,
    "denoise": false,
    "device": "CPU"
  },

  "lighting": {
    "disable_existing_lights": true,
    "world_strength": 0.0
  },

  "camera": {
    "width": 1280,
    "height": 720,
    "lens": 35.0,
    "sensor_width": 36.0,
    "shift_x": 0.0,
    "shift_y": 0.0
  },

  "projector": {
    "throw_ratio": 1.5,
    "power": 1000.0,
    "resolution": "1920x1080",
    "h_shift": 0.0,
    "v_shift": 0.0
  },

  "views": [
    {
      "name": "view_00",
      "camera": {
        "location": [0.0, -2.2, 0.15],
        "look_at": [0.0, 0.0, -0.1]
      },
      "projector": {
        "location": [0.45, -2.4, 0.15],
        "look_at": [0.0, 0.0, -0.1]
      }
    },
    {
      "name": "view_01",
      "camera": {
        "location": [-1.6, -1.6, 0.2],
        "look_at": [0.0, 0.0, -0.1]
      },
      "projector": {
        "location": [1.4, -1.9, 0.2],
        "look_at": [0.0, 0.0, -0.1]
      }
    }
  ]
}
